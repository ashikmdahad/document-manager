# AWS Configuration
aws_region = "us-east-1"

# Common Tags
common_tags = {
  Environment = "dev"
  Project     = "my-terraform-project"
  ManagedBy   = "terraform"
  Owner       = "DevOps Team"
}

# EC2 Configuration
ec2_instance_name    = "my-web-server"
ec2_instance_type    = "t3.micro"  # Change to t3.small, t3.medium, etc. as needed
ec2_ami_id          = "ami-0c02fb55956c7d316"  # Amazon Linux 2 in us-east-1
ec2_key_pair_name   = "my-key-pair"  # Replace with your actual key pair name
ec2_volume_size     = 20
ec2_volume_type     = "gp3"  # Options: gp2, gp3, io1, io2

# EC2 Security Group Rules (customize as needed)
ec2_security_group_rules = {
  ingress = [
    {
      from_port   = 22
      to_port     = 22
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]  # Restrict this to your IP for better security
      description = "SSH access"
    },
    {
      from_port   = 80
      to_port     = 80
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
      description = "HTTP access"
    },
    {
      from_port   = 443
      to_port     = 443
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
      description = "HTTPS access"
    }
  ]
  egress = [
    {
      from_port   = 0
      to_port     = 0
      protocol    = "-1"
      cidr_blocks = ["0.0.0.0/0"]
      description = "All outbound traffic"
    }
  ]
}

# RDS Configuration
rds_db_identifier       = "my-app-database"
rds_db_name            = "myappdb"
rds_db_username        = "admin"
rds_db_password        = "MySecurePassword123!"  # Use a strong password
rds_db_engine          = "mysql"  # Options: mysql, postgres, mariadb, etc.
rds_db_engine_version  = "8.0"
rds_db_instance_class  = "db.t3.micro"  # Change to db.t3.small, db.t3.medium, etc. as needed
rds_allocated_storage  = 20  # GB
rds_storage_type       = "gp2"  # Options: gp2, gp3, io1
rds_storage_encrypted  = true

# RDS Security Group Rules (customize as needed)
rds_security_group_rules = {
  ingress = [
    {
      from_port   = 3306
      to_port     = 3306
      protocol    = "tcp"
      cidr_blocks = ["10.0.0.0/8"]  # Allow access from VPC CIDR
      description = "MySQL access from VPC"
    }
  ]
  egress = []
}

# RDS Backup and Maintenance
rds_backup_retention_period = 7
rds_backup_window          = "03:00-04:00"
rds_maintenance_window     = "sun:04:00-sun:05:00"
